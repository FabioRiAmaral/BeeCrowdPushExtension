{
    "manifest_version": 3,
    "name": "BeeCrowd GitHub auto-push",
    "version": "0.0.1",
    "description": "Extensão simples e leve que tem como objetivo dar commit push para o GitHub sempre quando se tem uma resolução avaliada e correta.",
    "icons": {
        "16": "icons/extension-icon16x16.png",
        "32": "icons/extension-icon32x32.png",
        "48": "icons/extension-icon48x48.png",
        "64": "icons/extension-icon64x64.png",
        "96": "icons/extension-icon96x96.png",
        "128": "icons/extension-icon128x128.png"
    },
    "version_name": "BuildFs",
    "browser_specific_settings": {
        "gecko": {
            "id": "beeCrowdGitHunAutoPush@mozilla.org",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "content_scripts": [
        {
            "matches": ["*://judge.beecrowd.com/*/runs/code/*"],
            "js": ["beeCrowdPush.js"]
        }
    ]
}